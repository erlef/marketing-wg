#!/bin/sh

inkscape="/Applications/Inkscape.app/Contents/MacOS/inkscape"

if [ ! -x "$inkscape" ]; then
    echo "works on macos with inkscape. install"
    exit 1
fi

input=$1
if [ ! -f "$input" ]; then
    echo "$input missing"
    exit
fi

input1=${input##*/}
output="${input%.svg}-1200.png"

$inkscape \
    --export-filename=$output \
    --export-type=png \
    --export-area-page \
    --export-width 1200 \
    $input

pngoutput="${output%/*}/${input1%.svg}-1200-border.png"
magick $output -bordercolor none -border 30x30 $pngoutput

output="${input%.svg}-300.png"

$inkscape \
    --export-filename=$output \
    --export-type=png \
    --export-area-page \
    --export-width 300 \
    $input
